{
  "manifest_version": 3,
  "name": "Review Form Assistant",
  "version": "1.0.0",
  "description": "Suggests answers for visible multiple-choice questions on authorized, ungraded Google Forms review material. Never submits.",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],

  "action": {
    "default_title": "Review Form Assistant",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/d/e/*/viewform*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
