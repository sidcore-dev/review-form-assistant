# Copy to .env, or just use the setup page at http://127.0.0.1:8787/setup,
# which writes this file for you with owner-only permissions.
#
# Keys live only in the server process and in this file. They are never written
# into the extension, never sent to the browser, and never logged.

# Which provider to use: groq or openai.
PROVIDER=groq

# Groq free tier. Get a key at console.groq.com. Rate limited, no card required.
GROQ_API_KEY=

# OpenAI. Paid, needs credits on the account.
OPENAI_API_KEY=

# Optional. Defaults to the selected provider's model:
#   groq   -> openai/gpt-oss-120b
#   openai -> gpt-4.1-mini
# MODEL=

# Optional. Defaults to 8787. Must match the host permission in
# extension/manifest.json and SERVER_ORIGIN in extension/popup.js if changed.
# PORT=8787
